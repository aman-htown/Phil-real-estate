# Copy to .env at the repository root. Both apps read it in development.
# In production set these in Vercel (web) and Render/your host (worker).

# ── Shared ───────────────────────────────────────────────────────────────
# Same Postgres for worker and web. On Vercel use a pooled URL (Neon/Supabase pooler).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/phil

# ── Web UI (Vercel) ──────────────────────────────────────────────────────
# Shared team password for the inbox. People also enter their name when signing in.
ADMIN_PASSWORD=change-me
# Random string, 32+ chars, signs session cookies:  openssl rand -base64 32
AUTH_SECRET=

# ── Worker ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# cloud = official WhatsApp Business Cloud API (webhook)
# web   = WhatsApp Web linked device (scan a QR on the Status page)
# mock  = no WhatsApp; use the simulator on the Status page
WHATSAPP_TRANSPORT=mock
PORT=8080
# Apply database migrations when the worker starts.
RUN_MIGRATIONS=true
# LOG_LEVEL=info
# POLL_INTERVAL_MS=1500
# RESPONDER_CONCURRENCY=3

# Cloud API (WHATSAPP_TRANSPORT=cloud): developers.facebook.com → your app → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose; enter the same value as the webhook "Verify token" in the Meta dashboard.
WHATSAPP_VERIFY_TOKEN=
# App secret (App settings → Basic). Used to verify webhook signatures.
WHATSAPP_APP_SECRET=
# WHATSAPP_GRAPH_VERSION=v24.0

# WhatsApp Web (WHATSAPP_TRANSPORT=web): required for groups, phone-typed messages and history.
# Messages older than this that arrive after downtime are stored but not answered.
# WEB_MAX_BACKLOG_HOURS=12
# History imported when the phone is linked: full | recent | none
# WEB_HISTORY=full
